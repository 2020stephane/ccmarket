{
    "tags": {
        "allowUnknownTags": true
    },
    "source": {
        "include": [
            "server.js",
            "backend/routes",
            "backend/controllers",
            "backend/middlewares",
            "backend/tools",
            "backend/bdd/db.js"
        ],
        "includePattern": ".js$",
        "excludePattern": "(node_modules|docs|frontend|uploads)"
    },
    "plugins": [],
    "opts": {
        "destination": "./docs/api",
        "recurse": true,
        "readme": "./README.md"
    },
    "templates": {
        "cleverLinks": true,
        "monospaceLinks": true
    }
}
